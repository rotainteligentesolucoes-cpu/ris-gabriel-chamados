ENV=production
PORT=5000
SEED_DEMO_DATA=false
SESSION_HOURS=8
RUN_MIGRATIONS=true

# Gere chaves longas e diferentes antes de publicar:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cole_aqui_uma_chave_longa_e_secreta
JWT_SECRET=cole_aqui_outra_chave_longa_e_secreta

# Dominios liberados para API no navegador.
CORS_ORIGINS=https://app.rotainteligentesolucoes.com.br

# Protecao contra tentativa de senha e uploads grandes.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
MAX_UPLOAD_MB=12
MAX_SPREADSHEET_MB=8
MAX_PROOF_FILE_MB=10

# Em SaaS use PostgreSQL, nao SQLite.
# Exemplo Render/Railway:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DATABASE_URL=postgresql://usuario:senha@host:5432/ris

ORS_API_KEY=sua_chave_openrouteservice

MASTER_EMAIL=rotainteligentesolucoes@gmail.com
MASTER_PASSWORD=troque_esta_senha_por_uma_senha_forte
MASTER_NAME=Rota Inteligente Solucoes

# Arquivos externos (Cloudflare R2, AWS S3 ou servico compativel).
# Use local apenas no desenvolvimento. Em producao, prefira s3.
STORAGE_BACKEND=s3
S3_BUCKET=nome-do-bucket
S3_ENDPOINT_URL=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=chave-de-acesso
S3_SECRET_ACCESS_KEY=chave-secreta
S3_PREFIX=ris

# Backup logico diario. Em producao, mantenha tambem o backup nativo do PostgreSQL.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_CHECK_SECONDS=900
BACKUP_START_DELAY_SECONDS=30

# Monitoramento externo deve consultar:
# https://seu-dominio.com/healthz
